{
  "name": "@gridlinegpu/mcp",
  "version": "0.1.1",
  "description": "Gridline's MCP server: let an AI agent fine-tune, evaluate and batch open models through Gridline's OpenAI-compatible API.",
  "license": "MIT",
  "mcpName": "io.github.GridlineGPU/mcp",
  "homepage": "https://gridlinegpu.com/docs/agents",
  "keywords": [
