    "start": "bun src/main.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/bun": "^1.3.11",
    "typescript": "^7.0.2",
    "zod": "^4.4.3"
  }
